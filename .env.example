# ---------------------------------------------------------------
# Supabase — sifariş sorğuları burada saxlanılır.
# Dəyərlər: Supabase → layihəniz → Project Settings → API
#
# DİQQƏT: service_role açarı tam giriş hüququna malikdir.
# Onu heç vaxt frontend koduna yazmayın və VITE_ prefiksi verməyin.
# ---------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Resend — yeni sorğu gələndə e-poçt bildirişi.
# Açar: resend.com → API Keys
#
# Bunlar boş olsa, sayt işləməyə davam edir: sorğu bazaya yazılır,
# sadəcə bildiriş maili getmir.
# ---------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL=sizin@mail.com

# Domen alınandan sonra öz ünvanınızla əvəz edin,
# məsələn: Vintage Travel <info@vintagetravel.az>
RESEND_FROM=Vintage Travel <onboarding@resend.dev>
